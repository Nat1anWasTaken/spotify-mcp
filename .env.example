# Externally visible origin; OAuth metadata, the MCP resource URL and the
# Spotify redirect URI derive from it. Spotify does not accept `localhost`
# redirect URIs, so use 127.0.0.1 in development (the Vite dev server:
# http://127.0.0.1:5173).
PUBLIC_URL=http://127.0.0.1:5173
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://spotify_mcp:spotify_mcp@localhost:5444/spotify_mcp

# Spotify app from https://developer.spotify.com/dashboard (Web API).
# Redirect URI: $PUBLIC_URL/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 32 random bytes, base64. Encrypts Spotify tokens at rest: `openssl rand -base64 32`
ENCRYPTION_KEY=

# Optional: directory with the built dashboard (default web/dist) and log filter.
# WEB_DIST=web/dist
# RUST_LOG=info,spotify_mcp=debug,spotify=debug

# Production only (docker-compose.yml): password for the bundled Postgres.
# DATABASE_URL is derived from it there.
POSTGRES_PASSWORD=
